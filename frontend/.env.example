# Copy to frontend/.env.local for local work against a real Supabase project. Leave everything empty to run the
# original no-login version against a backend started with AUTH_ENABLED=false.
# On Render these are set on the static site (see render.yaml).

VITE_API_URL=                 # https://<api domain>; empty = same origin (the dev server proxies /api to localhost:8000)
VITE_SUPABASE_URL=            # https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=       # publishable (anon) key. Safe in the browser; the service-role key must NEVER go here
VITE_PRICE_LABEL=             # text only, e.g. "€9.99 / month". The real price is the Stripe price the backend uses
VITE_TERMS_URL=               # link shown in the footer once you have Terms of Service
VITE_PRIVACY_URL=             # link shown in the footer once you have a Privacy Policy
