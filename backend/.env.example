# Copy this file to backend/.env and fill in the values. Keys stay on the backend and are never sent to the browser.

# Three independent Groq accounts, one key per agent: https://console.groq.com/keys
#   Agent 1 = Statistical Researcher, Agent 2 = Football Intelligence & News Analyst, Agent 3 = Chief Predictor
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Model per agent. Empty = llama-3.3-70b-versatile. Use models your accounts can access: https://console.groq.com/docs/models
GROQ_MODEL_1=
GROQ_MODEL_2=
GROQ_MODEL_3=

# football-data.org token (free tier, 10 requests/minute): https://www.football-data.org/client/register
FOOTBALL_API_KEY=

# News for Agent 2 comes from Google News RSS (no key needed). Set to false to disable it; the analysis then runs
# without news, with lower data quality and lower confidence.
NEWS_ENABLED=true

# Goal model used by the 50,000-match simulation: poisson (default) | dixon_coles | bivariate.
# Only switch after /api/backtest shows the alternative is clearly better out of sample.
GOAL_MODEL=poisson
DC_RHO=-0.10     # Dixon-Coles correlation parameter (used only when GOAL_MODEL=dixon_coles)
BP_SHARE=0.10    # share of the scoring rate that is a shared shock (used only when GOAL_MODEL=bivariate)

# Folder for the append-only prediction history (predictions.jsonl, results.jsonl). Empty = backend/data_store
PREDICTIONS_DIR=

# --- Accounts & billing -------------------------------------------------
# Local development without login: AUTH_DISABLED=true (never set this in production)
AUTH_DISABLED=true
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated verified emails that use the app free of charge
ADMIN_EMAILS=
# Optional: use a Price created in the Stripe dashboard instead of the built-in 9.99 EUR/month
STRIPE_PRICE_ID=

# --- Optional web research (injuries, suspensions, lineups from the live web) ---
# Uses Groq's built-in browser_search tool, which only works with gpt-oss models and uses many tokens per run.
# A separate Groq key (a 4th account) is strongly recommended so it does not use up an agent's per-minute limit.
WEB_RESEARCH=false
WEB_RESEARCH_MODEL=openai/gpt-oss-20b
GROQ_API_KEY_4=

# Agent 4 "Data Scout": scrapes ESPN (lineups, shots, possession) and Understat (xG). Unofficial endpoints; each source fails independently.
SCOUT_ENABLED=true
