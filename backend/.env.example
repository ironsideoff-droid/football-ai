# Copy this file to backend/.env and fill in the values.
# Use THREE different Groq accounts (one key each): https://console.groq.com/keys
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Model per agent. Leave empty to use the default (llama-3.3-70b-versatile).
# Check https://console.groq.com/docs/models for the models your account can use.
GROQ_MODEL_1=
GROQ_MODEL_2=
GROQ_MODEL_3=

# football-data.org API token (free tier): https://www.football-data.org/client/register
FOOTBALL_API_KEY=

# Optional: let the Tactical Analyst also receive the Researcher's report.
# false = Agents 1 and 2 run concurrently on the same factual dataset (default).
# true  = Agent 2 waits for Agent 1 and receives its report as extra input.
PASS_RESEARCH_TO_TACTICAL=false
