# Copy this file to backend/.env and fill in the values. Keys stay on the backend and are never sent to the browser.
# In production these are set in the Render dashboard instead (see render.yaml and the README).

# ---------------------------------------------------------------- local development switch
# false = no login, no billing, predictions in local files (the original single-user behaviour).
# true (the default when unset) = production behaviour: Supabase login, Stripe subscription, Postgres.
AUTH_ENABLED=false

# ---------------------------------------------------------------- AI and football data
# Three independent Groq accounts, one key per agent: https://console.groq.com/keys
#   Agent 1 = Statistical Researcher, Agent 2 = Football Intelligence & News Analyst, Agent 3 = Chief Predictor
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Model per agent. Empty = llama-3.3-70b-versatile. Use models your accounts can access: https://console.groq.com/docs/models
GROQ_MODEL_1=
GROQ_MODEL_2=
GROQ_MODEL_3=

# football-data.org token (free tier, 10 requests/minute): https://www.football-data.org/client/register
FOOTBALL_API_KEY=

# News for Agent 2 comes from Google News RSS (no key needed). Set to false to disable it; the analysis then runs
# without news, with lower data quality and lower confidence.
NEWS_ENABLED=true

# Goal model used by the 50,000-match simulation: poisson (default) | dixon_coles | bivariate.
# Only switch after /api/backtest shows the alternative is clearly better out of sample.
GOAL_MODEL=poisson
DC_RHO=-0.10     # Dixon-Coles correlation parameter (used only when GOAL_MODEL=dixon_coles)
BP_SHARE=0.10    # share of the scoring rate that is a shared shock (used only when GOAL_MODEL=bivariate)

# Local-only folder for the append-only prediction history when DATABASE_URL is empty. Empty = backend/data_store
PREDICTIONS_DIR=

# ---------------------------------------------------------------- production (needed when AUTH_ENABLED=true)
# Supabase > Connect > Transaction pooler (port 6543). Apply supabase/migrations/*.sql to this database first.
DATABASE_URL=
SUPABASE_URL=                 # https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=          # only for old projects that still sign tokens with the legacy HS256 secret; leave empty otherwise

STRIPE_SECRET_KEY=            # sk_live_... (sk_test_... while testing)
STRIPE_WEBHOOK_SECRET=        # whsec_... of the endpoint https://<api domain>/api/stripe/webhook
STRIPE_PRICE_ID=              # price_... of the recurring EUR 9.99 / month price
STRIPE_AUTOMATIC_TAX=false    # true once Stripe Tax is set up (EU VAT)

APP_URL=http://localhost:5173 # public URL of the web app; used for Stripe return links. Must NOT be localhost in production
CORS_ORIGINS=                 # origin(s) allowed to call the API, comma-separated. Empty = http://localhost:5173
ADMIN_SECRET=                 # long random string; protects /api/evaluation/refresh and /api/backtest (X-Admin-Secret header)

DAILY_ANALYSIS_LIMIT=30       # new analyses per subscriber per UTC day (0 = unlimited). Already-analysed matches never count
MAX_CONCURRENT_ANALYSES=3     # analyses running at once; protects the Groq and football-data.org rate limits
